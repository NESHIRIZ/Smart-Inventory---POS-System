@model IEnumerable<SmartInventoryPOSSystem.Models.Supplier>
@{
    ViewData["Title"] = "Suppliers";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Suppliers</h1>
        <p class="text-muted">Track vendor details and supplier contacts for better purchase control.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Supplier</a>
</div>

<div class="page-intro">
    <h2>Supplier directory</h2>
    <p>Maintain accurate supplier information to streamline purchasing and ensure you can quickly reach the right vendor when inventory replenishment is needed.</p>
    <ul>
        <li>Record supplier phone, email, and address for faster order follow-up.</li>
        <li>Keep supplier metadata current so purchase decisions use reliable vendor data.</li>
        <li>Use supplier records to compare lead times and maintain stock availability.</li>
    </ul>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Phone</th>
            <th>Email</th>
            <th>Address</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var supplier in Model)
        {
            <tr>
                <td>@supplier.Name</td>
                <td>@supplier.PhoneNumber</td>
                <td>@supplier.Email</td>
                <td>@supplier.Address</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@supplier.Id" class="btn btn-sm btn-warning">Edit</a>
                    <form asp-action="Delete" asp-route-id="@supplier.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
