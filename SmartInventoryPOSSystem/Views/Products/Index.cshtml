@model SmartInventoryPOSSystem.ViewModels.ProductListViewModel
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Product Management</h1>
        <p class="text-muted">Manage your product catalog, pricing, inventory levels, and supplier mappings from this page.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Product</a>
</div>

<div class="page-intro">
    <h2>Product catalog guidance</h2>
    <p>Keep product details accurate for better sales checkout and inventory reporting. Use the search box to quickly find products by name, SKU, or barcode.</p>
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-10">
        <input asp-for="SearchTerm" name="search" class="form-control" placeholder="Search by name, SKU, or barcode" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Search</button>
    </div>
</form>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead>
            <tr>
                <th>Name</th>
                <th>SKU</th>
                <th>Barcode</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Category</th>
                <th>Supplier</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model.Products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.SKU</td>
                    <td>@product.Barcode</td>
                    <td>@product.Price.ToString("C")</td>
                    <td>@product.StockQuantity</td>
                    <td>@product.CategoryName</td>
                    <td>@product.SupplierName</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-sm btn-warning">Edit</a>
                        <form asp-action="Delete" asp-route-id="@product.Id" method="post" class="d-inline">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
