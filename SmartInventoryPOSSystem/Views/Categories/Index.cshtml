@model IEnumerable<SmartInventoryPOSSystem.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Categories</h1>
        <p class="text-muted">Use categories to organize products and simplify inventory browsing.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Add Category</a>
</div>

<div class="page-intro">
    <h2>Category management</h2>
    <p>Creating meaningful categories helps the team find products faster, improves reporting, and keeps stock classifications consistent across the business.</p>
    <ul>
        <li>Keep category names short and descriptive.</li>
        <li>Group similar products by department, type, or usage.</li>
        <li>Update assignments when products change or new product lines are added.</li>
    </ul>
</div>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Description</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var category in Model)
        {
            <tr>
                <td>@category.Name</td>
                <td>@category.Description</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@category.Id" class="btn btn-sm btn-warning">Edit</a>
                    <form asp-action="Delete" asp-route-id="@category.Id" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
